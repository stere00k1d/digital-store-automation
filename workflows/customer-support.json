        "respondWith": "json",
        "responseBody": "={{ {\n  \"answer\": $json.intent === \"question\"\n    ? $json.answer\n    : $json.stock_error,\n  \"order_id\": $json.order_id,\n  \"intent\": $json.intent,\n  \"product_id\": $json.product_id,\n  \"quantity\": $json.quantity,\n  \"stock\": $json.stock,\n  \"stock_ok\": $json.stock_ok\n} }}",
        "options": {}
      },
