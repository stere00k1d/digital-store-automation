    {
      "parameters": {
        "jsCode": "const data = JSON.parse($json.content);\n\nreturn [\n  {\n    json: {\n      ...data,\n      catalog: $('Edit Fields').first().json.catalog,\n      order_id: `ORD-${Date.now()}`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        0
      ],
      "id": "0f7bd9ed-8f33-44cd-b5a3-51fa67bd2aa3",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const catalog = $('Edit Fields').first().json.catalog;\n\nconst product = catalog[$json.product_id];\n\nif (!product) {\n  return [{\n    json: {\n      ...$json,\n      stock_ok: false,\n      stock_error: 'Товар не найден в каталоге'\n    }\n  }];\n}\n\nconst stockOk = product.stock >= $json.quantity;\n\nreturn [{\n  json: {\n    ...$json,\n    stock: product.stock,\n    stock_ok: stockOk,\n    stock_error: stockOk\n      ? null\n      : `Недостаточно товара. В наличии: ${product.stock} шт.`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        0
      ],
      "id": "72df7dc8-2a18-4166-ad4a-ca457a60a37b",
