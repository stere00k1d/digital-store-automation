              "name": "catalog",
              "value": "={{ {\n  \"PSN_US_25\": {\n    \"name\": \"PlayStation Store Gift Card $25 — USA\",\n    \"price_rub\": 0,\n    \"stock\": 2,\n    \"region\": \"USA\",\n    \"type\": \"gift_card\"\n  },\n  \"PSN_US_50\": {\n    \"name\": \"PlayStation Store Gift Card $50 — USA\",\n    \"price_rub\": 0,\n    \"stock\": 1,\n    \"region\": \"USA\",\n    \"type\": \"gift_card\"\n  }\n} }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
