    {
      "parameters": {
        "jsCode": "const catalog = $('Edit Fields').first().json.catalog;\nconst product = catalog[$json.product_id];\n\nconst purchasePrice = product.price_rub;\nconst sellingPrice = product.price_rub; // временно, пока реальные цены не внесены\n\nconst totalCost = purchasePrice * $json.quantity;\nconst totalSelling = sellingPrice * $json.quantity;\nconst profit = totalSelling - totalCost;\n\nreturn [{\n  json: {\n    ...$json,\n\n    product_name: product.name,\n\n    selling_price: sellingPrice,\n    purchase_price: purchasePrice,\n\n    total_cost: totalCost,\n    total_selling: totalSelling,\n    profit: profit,\n\n    order_status: 'pending'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
